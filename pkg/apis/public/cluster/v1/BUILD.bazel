# Cluster APIs.

load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "api_package")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "v1_typedata",
    srcs = [
        "annotations.go",
        "cluster_types.go",
        "condition_types.go",
        "doc.go",
        "groupversion_info.go",
        "userclusterupgraderequest_types.go",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public",
        "//pkg/apis/public/upgrade/v1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

api_package(
    name = "v1_api",
    targets = [":v1_typedata"],
)

go_library(
    name = "v1",
    srcs = [
        "annotations.go",
        "cluster_states.go",
        "cluster_types.go",
        "condition_types.go",
        "constants.go",
        "doc.go",
        "generated.deepcopy.go",  # keep
        "groupversion_info.go",
        "labels.go",
        "node_pool.go",
        "userclusterupgraderequest_types.go",
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/cluster/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public",
        "//pkg/apis/public/upgrade/v1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/k8s.io/apimachinery/pkg/types",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

go_test(
    name = "cluster_test",
    srcs = [
        "constants_test.go",
        "node_pool_test.go",
    ],
    embed = [":v1"],  # keep
    deps = [
        "//vendor/github.com/google/go-cmp/cmp",
        "//vendor/k8s.io/apimachinery/pkg/types",
        "//vendor/k8s.io/utils/ptr",
    ],
)
