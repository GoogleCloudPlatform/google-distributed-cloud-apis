load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "deepcopygen")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "dbcluster_typedata",
    srcs = ["dbcluster_types.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/dbs/enterprise/export/v1:export",
        "//pkg/apis/public/dbs/enterprise/ha/v1:ha",
        "//pkg/apis/public/dbs/enterprise/import/v1:import",
        "//pkg/apis/public/dbs/omnicore/core/v1:core",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",
    ],
)

deepcopygen(
    name = "dbcluster_deepcopy",
    targets = [":dbcluster_typedata"],
    visibility = ["//visibility:public"],
)

write_source_files(
    name = "dbcluster_deepcopy_copy",
    files = {
        "zz_generated.deepcopy.go": ":dbcluster_deepcopy",
    },
)

go_library(
    name = "dbcluster",
    srcs = [
        "dbcluster_types.go",
        "zz_generated.deepcopy.go",  # keep
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/dbs/enterprise/dbcluster/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/dbs/enterprise/export/v1:export",
        "//pkg/apis/public/dbs/enterprise/ha/v1:ha",
        "//pkg/apis/public/dbs/enterprise/import/v1:import",
        "//pkg/apis/public/dbs/omnicore/core/v1:core",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
    ],
)
