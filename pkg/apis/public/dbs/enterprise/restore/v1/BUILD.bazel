load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "deepcopygen")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "restore_typedata",
    srcs = [
        "omnisvc_restore.go",
        "restore.go",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/dbs/enterprise/common",
        "//pkg/apis/public/dbs/omnicore/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/client",
    ],
)

deepcopygen(
    name = "restore_deepcopy",
    targets = [":restore_typedata"],
    visibility = ["//visibility:public"],
)

write_source_files(
    name = "restore_deepcopy_copy",
    files = {
        "zz_generated.deepcopy.go": ":restore_deepcopy",
    },
)

go_library(
    name = "restore",
    srcs = [
        "omnisvc_restore.go",
        "restore.go",
        "zz_generated.deepcopy.go",  # keep
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/dbs/enterprise/restore/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/dbs/enterprise/common",
        "//pkg/apis/public/dbs/omnicore/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/sigs.k8s.io/controller-runtime/pkg/client",
    ],
)
