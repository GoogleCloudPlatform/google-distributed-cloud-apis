api_package(
    name = "fleet_api",
    targets = [":fleet_typedata"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "fleet",
    srcs = [
        "connectionprofile.go",
        "controlplaneagentsversion_types.go",
        "databaseparameters_types.go",
        "databaseversion_types.go",
        "failover_types.go",
        "groupversion_info.go",
        "softwarelibrary_types.go",
        "time.go",
        "zz_generated.deepcopy.go",  # keep
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/dbs/fleet/fleet/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/dbs/enterprise/ha/v1:ha",
        "//pkg/apis/public/dbs/omnicore/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/api/resource",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)
