load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules:global_api.bzl", "mux_api_package")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")

# gazelle:exclude zz_generated.*.go
# generate with bazel run :api_deepcopy_copy && bazel run :api_mux_copy

kubebuilder_analyze(
    name = "v1alpha1_typedata",
    srcs = [
        "doc.go",
        "managedsiem_types.go",
        "managedsiemreplica_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/global/siem/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/common/global/v1alpha1",
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public/siem/v1alpha1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/api/resource",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)

kubebuilder_analyze(
    name = "replica_typedata",
    srcs = [
        "doc.go",
        "managedsiemreplica_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/global/siem/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public/siem/v1alpha1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)

mux_api_package(
    name = "api",
    mux_dep = "//pkg/apis/common/global/v1alpha1",
    mux_types = ["ManagedSIEM"],
    targets = [":v1alpha1_typedata"],
)

go_library(
    name = "v1alpha1",
    srcs = [
        "condition.go",
        "doc.go",
        "generated.deepcopy.go",  # keep
        "generated.mux.go",  # keep
        "groupversion_info.go",
        "managedsiem_types.go",
        "managedsiemreplica_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/global/siem/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/common/global/v1alpha1",
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public/global",
        "//pkg/apis/public/siem/v1alpha1",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

go_test(
    name = "v1alpha1_test",
    srcs = ["condition_test.go"],
    embed = [":v1alpha1"],
    deps = [
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)
