load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "api_package")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "v1_typedata",
    srcs = [
        "groupversion_info.go",
        "volumereplicationrelationship_types.go",
        "volumereplicationrelationshipreplica_types.go",
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/global/storage/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/common/global/v1alpha1",
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/private/system/v1alpha1",
        "//vendor/github.com/go-openapi/strfmt",
        "//vendor/github.com/xeipuuv/gojsonschema",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/api/errors",
        "//vendor/k8s.io/apimachinery/pkg/api/resource",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/k8s.io/apimachinery/pkg/util/validation/field",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/webhook",
    ],
)

kubebuilder_analyze(
    name = "replica_typedata",
    srcs = [
        "volumereplicationrelationshipreplica_types.go",
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/global/storage/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/common/global/v1alpha1",
        "//vendor/github.com/go-openapi/strfmt",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)

api_package(
    name = "v1_api",
    targets = [":v1_typedata"],
)

go_library(
    name = "v1",
    srcs = [
        "groupversion_info.go",
        "volumereplicationrelationship_types.go",
        "volumereplicationrelationshipreplica_types.go",
        ":generated.deepcopy.go",  #keep
    ],
    importpath = "gke-internal.googlesource.com/private-cloud/pkg/apis/public/global/storage/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/common/global/v1alpha1",
        "//pkg/apis/public",
        "//vendor/github.com/go-openapi/strfmt",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  #keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)
