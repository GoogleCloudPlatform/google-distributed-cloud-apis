# Bucket APIs.
load("//build/rules/controller_gen:kubebuilder.bzl", "crdgen")

filegroup(
    name = "v1_srcs",
    srcs = [
        "//pkg/apis/public/object/v1:v1_api_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

# These are the CRDs that are just available in the mgmt cluster. There should not be any non-mgmt crds in public.
crdgen(
    name = "mgmt_crds_yaml",
    out = "public_mgmt_bucket_crds.yaml",
    annotations = {
        "cert-manager.io/inject-ca-from": "gpc-system/obj-bucket-cm-webhooks-serving-cert",
    },
    targets = [
        "//pkg/apis/public/object/v1:mgmt_v1_typedata",
    ],
    visibility = ["//oc/obj/subs/bucket-cm:__subpackages__"],
)
