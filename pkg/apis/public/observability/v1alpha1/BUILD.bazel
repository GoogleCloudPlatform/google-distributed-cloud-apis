load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "api_package")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "v1alpha1_typedata",
    srcs = [
        "condition_types.go",
        "dashboard_types.go",
        "groupversion_info.go",
        "label_consts.go",
        "observabilitypipeline_types.go",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

api_package(
    name = "v1alpha1_api",
    targets = [":v1alpha1_typedata"],
)

go_library(
    name = "v1alpha1",
    srcs = [
        "condition_types.go",
        "dashboard_conversion.go",
        "dashboard_types.go",
        "generated.deepcopy.go",  # keep
        "groupversion_info.go",
        "label_consts.go",
        "observabilitypipeline_conversion.go",
        "observabilitypipeline_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/observability/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public",
        "//pkg/apis/public/observability/v1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/conversion",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

go_test(
    name = "v1alpha1_test",
    srcs = [
        "dashboard_conversion_test.go",
        "observabilitypipeline_conversions_test.go",
    ],
    embed = [":v1alpha1"],
    deps = [
        "//pkg/apis/public/observability/v1",
        "//vendor/github.com/google/go-cmp/cmp",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)
