load("//build/rules/controller_gen:kubebuilder.bzl", "crdgen")

filegroup(
    name = "srcs",
    srcs = [
        "//pkg/apis/public/resourcemanager/v1:v1_api_srcs",
        "//pkg/apis/public/resourcemanager/v1alpha1:v1alpha1_api_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "project_types",
    srcs = [
        "//pkg/apis/public/resourcemanager/v1alpha1:project_types",
    ],
    visibility = ["//:__subpackages__"],
)

# If you need both the v1 and v1alpha1 CRDs, use this target so that
# the storage version can be properly set to the v1 version in the CRD
# definition.
crdgen(
    name = "all_crds",
    targets = [
        "//pkg/apis/public/resourcemanager/v1:v1_typedata",
        "//pkg/apis/public/resourcemanager/v1alpha1:v1alpha1_typedata",
    ],
    visibility = ["//visibility:public"],
)
