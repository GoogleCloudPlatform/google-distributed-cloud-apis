load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "api_package")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "v1_typedata",
    srcs = [
        "capool_types.go",
        "certificate_types.go",
        "certificateauthority_types.go",
        "certificateissuer_types.go",
        "certificaterequest_types.go",
        "consts.go",
        "doc.go",
        "groupversion_info.go",
        "revokecertificaterequest_types.go",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public/security",
        "//vendor/github.com/cert-manager/cert-manager/pkg/apis/acme/v1:acme",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

api_package(
    name = "v1_api",
    targets = [":v1_typedata"],
)

go_library(
    name = "v1",
    srcs = [
        "capool_types.go",
        "certificate_types.go",
        "certificateauthority_types.go",
        "certificateissuer_types.go",
        "certificaterequest_types.go",
        "consts.go",
        "doc.go",
        "generated.deepcopy.go",  # keep
        "groupversion_info.go",
        "revokecertificaterequest_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/security/pki/v1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/core/v1alpha1",
        "//pkg/apis/public/security",
        "//vendor/github.com/cert-manager/cert-manager/pkg/apis/acme/v1:acme",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)
