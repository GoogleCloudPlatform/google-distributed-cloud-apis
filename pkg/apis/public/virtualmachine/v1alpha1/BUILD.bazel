load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/rules/controller_gen:aspect.bzl", "kubebuilder_analyze")
load("//build/rules/controller_gen:kubebuilder.bzl", "api_package")

# gazelle:exclude zz_generated.*.go

kubebuilder_analyze(
    name = "v1alpha1_typedata",
    srcs = [
        "doc.go",
        "groupversion_info.go",
        "vm_image_import_types.go",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/private/system/v1alpha1",
        "//pkg/apis/public/virtualmachineview/v1alpha1",
        "//vendor/k8s.io/apimachinery/pkg/api/resource",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

api_package(
    name = "v1alpha1_api",
    targets = [":v1alpha1_typedata"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "v1alpha1",
    srcs = [
        "doc.go",
        "generated.deepcopy.go",  # keep
        "groupversion_info.go",
        "vm_image_import_conversion.go",
        "vm_image_import_types.go",
    ],
    importpath = "github.com/googlecloudplatform/google-distributed-cloud-apis/pkg/apis/public/virtualmachine/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/public/virtualmachine/v1",
        "//pkg/apis/public/virtualmachineview/v1alpha1",
        "//vendor/k8s.io/api/core/v1:core",
        "//vendor/k8s.io/apimachinery/pkg/api/resource",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
        "//vendor/k8s.io/apimachinery/pkg/runtime",  # keep
        "//vendor/k8s.io/apimachinery/pkg/runtime/schema",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/conversion",
        "//vendor/sigs.k8s.io/controller-runtime/pkg/scheme",
    ],
)

go_test(
    name = "v1alpha1_test",
    srcs = ["vm_image_import_conversion_test.go"],
    embed = [":v1alpha1"],
    deps = [
        "//pkg/apis/public/virtualmachine/v1",
        "//pkg/apis/public/virtualmachineview/v1alpha1",
        "//vendor/github.com/google/go-cmp/cmp",
        "//vendor/k8s.io/apimachinery/pkg/apis/meta/v1:meta",
    ],
)
